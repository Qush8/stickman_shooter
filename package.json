{
  "name": "my-shooter-game",
  "version": "0.1.16",
  "type": "module",
  "private": true,
  "bordiko": {
    "gameId": "stickman-shooter",
    "displayName": "Stickman Shooter",
    "minPlayers": 2,
    "maxPlayers": 4,
    "board": "custom",
    "realtime": {
      "tick": true,
      "tickRate": 30
    }
  },
  "scripts": {
    "build:ui": "node scripts/embed-sfx.mjs && esbuild src/ui.js --bundle --format=iife --minify --keep-names --outfile=dist/ui.bundle.js && node build-ui.cjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:ui && bordiko build",
    "prepublish:game": "npm run build",
    "publish:game": "node scripts/publish.mjs",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@bordiko/sdk": "^0.2.0",
    "planck": "^1.4.2"
  },
  "devDependencies": {
    "@bordiko/cli": "^0.1.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1"
  }
}
